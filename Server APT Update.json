        "jsonBody": "={{\n  JSON.stringify({\n    title: \"Nebula Updates\",\n    message: $json.updates || \"No updates available\",\n    data: {\n      actions: [\n        { \n          action: \"APPROVE_UPDATES\", \n          title: \"Install\" \n        },\n        { \n          action: \"DISMISS\", \n          title: \"Dismiss\" \n        }\n      ]\n    }\n  })\n}}",
        "options": {}
      },
